# ==============================================================================
# AgriChain AI — Root Environment Configuration Template (.env.example)
#
# COPY THIS FILE TO .env AND POPULATE WITH LOCAL DEVELOPMENT VALUES.
# NEVER COMMIT REAL CREDENTIALS, KEYS, OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Project & Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AgriChain AI"

# Backend & API Gateway
API_V1_STR="/api/v1"
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL / PostGIS Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrichain_db
POSTGRES_USER=agrichain_user
POSTGRES_PASSWORD=your_secure_password_here

# Next.js Web Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/shipments
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here_if_applicable

# Machine Learning & Inference
MODEL_DEVICE=cuda
MODEL_ARTIFACT_DIR=ml/artifacts
KINNOW_MODEL_CHECKPOINT=ml/artifacts/best_kinnow_resnet18.pth
