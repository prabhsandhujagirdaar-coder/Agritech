# ==============================================================================
# AgriChain AI — Backend Environment Template (backend/.env.example)
#
# COPY THIS FILE TO backend/.env FOR LOCAL BACKEND CONFIGURATION.
# ==============================================================================

PROJECT_NAME="AgriChain AI Backend"
API_V1_STR="/api/v1"
DEBUG=True

# Server Bindings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Relational & Spatial Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+asyncpg://agrichain_user:your_secure_password_here@localhost:5432/agrichain_db
SYNC_DATABASE_URL=postgresql://agrichain_user:your_secure_password_here@localhost:5432/agrichain_db

# ML Inference Configuration
MODEL_DEVICE=cuda
MODEL_BACKBONE=resnet18
MODEL_NUM_CLASSES=3
MODEL_WEIGHTS_PATH=../../ml/artifacts/best_kinnow_resnet18.pth
CONFIDENCE_THRESHOLD=0.70
