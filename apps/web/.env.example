# ==============================================================================
# AgriChain AI — Next.js Web Dashboard Environment Template (apps/web/.env.example)
#
# COPY THIS FILE TO apps/web/.env.local FOR LOCAL WEB DEVELOPMENT.
# ==============================================================================

# Public API Gateway URL consumed by Next.js client & server actions
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ML_API_URL=http://127.0.0.1:8000
BACKEND_API_URL=http://127.0.0.1:8000

# Map Provider Token (if visual map layers are enabled)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here_if_applicable

# WebSocket URL for real-time shipment updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/shipments

# Next.js Application Port
PORT=3000
