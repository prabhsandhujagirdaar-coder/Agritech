# ==============================================================================
# AgriChain AI — Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
*.env.development
*.env.development.local
*.env.test
*.env.test.local
*.env.production
*.env.production.local
!.env.example
!**/.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
secrets/
credentials.json
service-account*.json
*.token

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Node.js & Next.js (apps/web)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
**/apps/web/.next/
out/
.turbo/
.vercel/
coverage/

# ------------------------------------------------------------------------------
# Flutter & Dart & Android (apps/mobile)
# ------------------------------------------------------------------------------
.dart_tool/
**/apps/mobile/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
**/apps/mobile/build/
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/GeneratedPluginRegistrant.java
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
*.apk
*.aab
*.ipa

# ------------------------------------------------------------------------------
# Machine Learning: Datasets & Intermediate Training Runs
# ------------------------------------------------------------------------------
# Raw and interim heavy datasets (>5 GB) - download instructions in docs/DATASET_SETUP.md
ml/data/raw/
ml/data/processed/
ml/data/guava_classification/
ml/data/interim/
!ml/data/.gitkeep
!ml/data/README.md
!ml/data/manifests/
!ml/data/reports/

# Temporary training checkpoints & weights (authoritative models stored in ml/artifacts/ via Git LFS)
*.ckpt
*.onnx
*.h5
*.pb
*.tflite
*.safetensors
yolov8n.pt
weights/
runs/

# ------------------------------------------------------------------------------
# Database & Local Runtime Persistence
# ------------------------------------------------------------------------------
# Mutating local JSON runtime state ledger (re-created dynamically on boot from seeds)
backend/app/db/.persisted_session.json
backend/app/db/.persisted_session.tmp
backend/app/db/*.tmp
*.sqlite3
*.db
database/data/

# ------------------------------------------------------------------------------
# OS & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.log
scratch/
tmp/
